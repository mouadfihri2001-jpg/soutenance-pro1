# All values belong in Vercel Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Project-wide conservative request budgets; not a provider billing-account cap.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=30
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only: never expose the service role key in HTML or a frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: canonical public origin after connecting the custom domain.
# Defaults to the owner's domain https://soutenancepro.com; does not affect Auth readiness.
SITE_URL=https://soutenancepro.com

# Automatic subscription billing stays disabled until the billing migration,
# matching Stripe prices and signed webhook endpoint are configured together.
STRIPE_BILLING_ENABLED=false
# Use an isolated Supabase project for test mode; production requires live.
STRIPE_MODE=live
# Server-only restricted key (rk_live_...) with the necessary Billing permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing EUR 19 / EUR 29 licensed recurring monthly Price IDs (price_...),
# not Payment Link URLs. Both must belong to the same account and mode as the key.
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_SIGNATURE=
