# All values belong in Vercel Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only: never expose the service role key in HTML or a frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: canonical public origin after connecting the custom domain.
# Defaults to https://soutenance-pro1.vercel.app and does not affect Auth readiness.
SITE_URL=https://soutenance-pro1.vercel.app
