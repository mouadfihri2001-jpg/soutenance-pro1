# All values belong in Vercel Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Project-wide conservative request budgets; not a provider billing-account cap.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=30
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Server only: never expose the service role key in HTML or a frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: canonical public origin after connecting the custom domain.
# Defaults to the owner's domain https://soutenancepro.com; does not affect Auth readiness.
SITE_URL=https://soutenancepro.com
